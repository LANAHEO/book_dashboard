{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/main", "destination": "/index.html" },
    { "source": "/landing", "destination": "/landing/index.html" },
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ]
}
